---
import Layout from '@/layouts/Layout.astro';
import { BrandPageLayout } from '@/components/BrandPageLayout';
import { BRAND_PAGES_DATA, BUSINESS_DETAILS } from '@/data/content';
import type { BrandInfo } from '@/types';

export const prerender = false;

function getBrand(key: string): BrandInfo | undefined {
  if (!key) return undefined;
  if (BRAND_PAGES_DATA[key]) return BRAND_PAGES_DATA[key];
  if (BRAND_PAGES_DATA[`${key}-service`]) return BRAND_PAGES_DATA[`${key}-service`];
  return Object.values(BRAND_PAGES_DATA).find(
    (b) =>
      b.id === key ||
      b.id === key.replace(/-service$/, '') ||
      b.slug === `/${key}` ||
      b.slug === `/${key}-service` ||
      b.name.toLowerCase() === key.toLowerCase()
  );
}

const { brand: brandKey } = Astro.params;
const brand = getBrand(brandKey || '');

if (!brand) {
  return Astro.redirect('/404');
}

const isSubdomain = Boolean(Astro.locals.subdomain);
const subdomainHost = Astro.locals.subdomainHost;
const subdomainProto = Astro.locals.subdomainProto ?? 'https';

const defaultUrl = `https://www.roservicesupport.co.in/${brandKey}`;
const pageUrl = isSubdomain && subdomainHost
  ? `${subdomainProto}://${subdomainHost}`
  : defaultUrl;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    url: pageUrl,
    name: `${brand.name} Water Purifier Repair & Service Bangalore`,
    serviceType: 'Water Purifier Repair, Maintenance & Filter Replacement',
    provider: {
      '@type': 'LocalBusiness',
      '@id': 'https://www.roservicesupport.co.in/#localbusiness',
      name: BUSINESS_DETAILS.name,
      telephone: `+91${BUSINESS_DETAILS.phone}`,
      url: 'https://www.roservicesupport.co.in',
    },
    areaServed: { '@type': 'City', name: 'Bangalore' },
    description: brand.metaDescription,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'INR',
      description:
        'Doorstep inspection and diagnosis, 100% adjusted against final repair bill upon approval.',
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.8',
      reviewCount: '10480',
      bestRating: '5',
      worstRating: '1',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: brand.brandFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<Layout
  title={brand.metaTitle}
  description={brand.metaDescription}
  canonical={pageUrl}
  ogTitle={brand.metaTitle}
  ogDescription={brand.metaDescription}
  ogUrl={pageUrl}
  ogImage={brand.heroImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <BrandPageLayout brand={brand} client:only="react" />
</Layout>